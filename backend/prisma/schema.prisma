generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  password String
  token    String   @unique
  tm       DateTime @default(now())
  rank     RANK     @default(USER)
  deaths   Death[]
}

model Death {
  id          Int      @id @default(autoincrement())
  tm          DateTime @default(now())
  AreaSID     Int
  LevelName   String
  Side		  String
  GoldenBerry Boolean
  PositionX	  Float
  PositionY	  Float
  AuthorId    Int
  Author      User     @relation(fields: [AuthorId], references: [id])
}

enum RANK {
	USER
	ADMIN
}
